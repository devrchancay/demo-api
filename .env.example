# Local development. A deployed container gets NODE_ENV, APP_ENV and PORT from the
# platform and nothing else, so every other variable must have a working default.
NODE_ENV=development
APP_ENV=local
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional. Without it the service starts with no database and /health reports
# "not-configured". `pnpm db:up` starts the Postgres in docker-compose.yml.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
