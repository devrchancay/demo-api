{
  "name": "template-backend-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Company template for a backend-api project. Rename this field after creating a repo from it.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:template": "biome check --config-path=biome.template.json && tsc -p tsconfig.template.json --noEmit && vitest run --config vitest.template.config.ts",
    "check:all": "pnpm check && pnpm test:template",
    "spec:new": "tsx scripts/new-spec.ts",
    "spec:validate": "tsx .claude/skills/company/scripts/validate.ts",
    "spec:manifest": "tsx .claude/skills/company/scripts/gen-manifest.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "image:build": "docker build -t template-backend-api:local ."
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
